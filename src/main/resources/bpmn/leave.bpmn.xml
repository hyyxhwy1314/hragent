<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="Definitions_1"
             targetNamespace="http://flowable.org/bpmn">

    <process id="leave_apply" name="请假申请流程" isExecutable="true">
        <startEvent id="startEvent1"/>
        <sequenceFlow id="flow1" sourceRef="startEvent1" targetRef="auditTask"/>

        <!-- 用户任务：领导审批 -->
        <userTask id="auditTask" name="领导审批" assignee="${leader}"/>
        <sequenceFlow id="flow2" sourceRef="auditTask" targetRef="endEvent"/>

        <endEvent id="endEvent"/>
