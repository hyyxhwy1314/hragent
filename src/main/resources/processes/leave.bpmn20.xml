<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="Definitions_leave"
             targetNamespace="http://flowable.org/bpmn">

    <!--离职流程-->
    <process id="leave-process" name="离职申请流程" isExecutable="true">
        <!--开始节点：员工发起离职-->
        <startEvent id="leave_start" name="发起离职申请"/>
        <sequenceFlow id="flow_l1" sourceRef="leave_start" targetRef="leave_1_dept_audit"/>

        <!--节点1：直属上级审批 审批人启动流程传入${approver_dept}-->
        <userTask id="leave_1_dept_audit" name="直属上级审批"
                  flowable:assignee="${approver_dept}"/>
        <sequenceFlow id="flow_l2" sourceRef="leave_1_dept_audit" targetRef="leave_gw_dept"/>

        <!--网关1：上级审批结果判断-->
        <exclusiveGateway id="leave_gw_dept" name="直属上级审批结果"/>
        <sequenceFlow id="flow_l3" sourceRef="leave_gw_dept" targetRef="leave_2_hr_audit">
            <conditionExpression xsi:type="tFormalExpression">${approved}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flow_l4" sourceRef="leave_gw_dept" targetRef="leave_end_rejected">
            <conditionExpression xsi:type="tFormalExpression">${!approved}</conditionExpression>
        </sequenceFlow>

        <!--节点2：HR人事审核 候选组HR-->
        <userTask id="leave_2_hr_audit" name="HR人事审核"
                  flowable:assignee="${approver_hr}"
                  flowable:candidateGroups="HR"/>
        <sequenceFlow id="flow_l5" sourceRef="leave_2_hr_audit" targetRef="leave_gw_hr"/>

        <!--网关2：HR审核结果判断-->
        <exclusiveGateway id="leave_gw_hr" name="HR审核结果"/>
        <sequenceFlow id="flow_l6" sourceRef="leave_gw_hr" targetRef="leave_3_auto_leave">
            <conditionExpression xsi:type="tFormalExpression">${approved}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flow_l7" sourceRef="leave_gw_hr" targetRef="leave_end_rejected">
            <conditionExpression xsi:type="tFormalExpression">${!approved}</conditionExpression>
        </sequenceFlow>

        <!--自动服务任务：离职后置业务，JavaDelegate 更新员工状态为离职、冻结账号、清空岗位等-->
        <serviceTask id="leave_3_auto_leave" name="执行离职操作"
                     flowable:delegateExpression="${leaveApprovedDelegate}"/>
        <sequenceFlow id="flow_l8" sourceRef="leave_3_auto_leave" targetRef="leave_end_success"/>

        <!--结束节点：离职成功-->
        <endEvent id="leave_end_success" name="离职完成"/>
        <!--结束节点：离职驳回-->
        <endEvent id="leave_end_rejected" name="离职申请驳回"/>
    </process>
</definitions>
